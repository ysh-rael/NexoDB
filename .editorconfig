# =============================================================================
# .editorconfig
# Garante consistencia basica de formatacao entre editores/IDEs para todo o
# projeto (C++, JS, JSON, Markdown, YAML).
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,hpp,h}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
